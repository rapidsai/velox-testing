x-presto-native-worker-gpu: &gpu_worker_base
  extends:
    file: ../../docker-compose.common.yml
    service: presto-base-native-worker
  image: presto-native-worker-gpu:${PRESTO_IMAGE_TAG:?PRESTO_IMAGE_TAG must be set}
  build:
    args:
      - GPU=ON
{% if sccache %}
    ulimits: {nofile: {soft: 500000, hard: 500000}}
    secrets:
      - github_token
      - aws_credentials
{% endif %}
  runtime: nvidia
  cap_add:
    - IPC_LOCK
    - SYS_ADMIN  # Required for nsys GPU metrics profiling
    - SYS_NICE   # Required for numactl --cpunodebind/--membind under Docker's default seccomp profile (gates set_mempolicy/mbind/get_mempolicy)
  pid: host
  ulimits:
    memlock: -1
    stack: 67108864
  shm_size: 1g
  # UCX needs the containers to be able to see all devices, although we then need to limit which they use.
  deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
  # EFA/IB character devices. The current g7e.48xlarge experiment attaches
  # one EFA-only interface per network card.
  devices:
    - /dev/infiniband/rdma_cm
    - /dev/infiniband/uverbs0
    - /dev/infiniband/uverbs1
    - /dev/infiniband/uverbs2
    - /dev/infiniband/uverbs3
  depends_on:
    - presto-coordinator
  volumes:
  # required for numa
    - /sys/devices/system/node:/sys/devices/system/node
    # Reuse the host's managed S3 frontend mappings in every worker container.
    - /etc/hosts:/etc/hosts:ro
    - ../../config/generated/gpu/etc_common:/opt/presto-server/etc
    - ../../config/generated/gpu/etc_worker/node.properties:/opt/presto-server/etc/node.properties
    - ../../config/generated/gpu/etc_worker/config_native.properties:/opt/presto-server/etc/config.properties
    - ../../config/generated/gpu/etc_worker/catalog/hive.properties:/opt/presto-server/etc/catalog/hive.properties

services:
  presto-coordinator:
    extends:
      file: ../../docker-compose.common.yml
      service: presto-base-coordinator
    volumes:
      - ../../config/generated/gpu/etc_common:/opt/presto-server/etc
      - ../../config/generated/gpu/etc_coordinator/config_native.properties:/opt/presto-server/etc/config.properties
      - ../../config/generated/gpu/etc_coordinator/node.properties:/opt/presto-server/etc/node.properties
      - ../../config/generated/gpu/etc_coordinator/catalog/hive.properties:/opt/presto-server/etc/catalog/hive.properties

  {% if workers|length > 1 and not single_container %}
  # Separate GPU workers - runs each worker in a separate container, pinned to a specific GPU
  {% for gpu_id in workers %}
  presto-native-worker-gpu-{{ gpu_id }}:
    <<: *gpu_worker_base
    container_name: presto-native-worker-gpu-{{ gpu_id }}
    # Host networking exposes the four ENAs so libcurl can bind each worker to
    # the interface nearest its GPU. Worker HTTP and UCX ports are unique.
    network_mode: host
    environment:
      WORKER_ID: {{ gpu_id }}
      NVIDIA_VISIBLE_DEVICES: all
      PROFILE: ${PROFILE:-}
      PROFILE_ARGS: ${PROFILE_ARGS:-}
      SERVER_START_TIMESTAMP: ${SERVER_START_TIMESTAMP:-}
      LD_LIBRARY_PATH: /opt/ucx-runtime/lib:/opt/ucx-runtime/lib/ucx:/usr/lib64/presto-native-libs
      UCX_MODULE_DIR: /opt/ucx-runtime/lib/ucx
      UCX_LOG_LEVEL: info #debug
      UCX_RNDV_PIPELINE_ERROR_HANDLING: ${UCX_RNDV_PIPELINE_ERROR_HANDLING:-y}
      UCX_RNDV_FRAG_SIZE: ${UCX_RNDV_FRAG_SIZE:-host:4M,cuda:4M}
      UCX_CUDA_COPY_ASYNC_MEM_TYPE: ${UCX_CUDA_COPY_ASYNC_MEM_TYPE:-cuda-managed}
      UCX_MAX_RNDV_RAILS: ${UCX_MAX_RNDV_RAILS:-1}
      UCX_TLS: ${UCX_TLS:-tcp,sm,cuda_copy,cuda_ipc}
      UCX_NET_DEVICES: ${UCX_NET_DEVICES_GPU_{{ gpu_id }}:-}
      UCX_SOCKADDR_TLS_PRIORITY: ${UCX_SOCKADDR_TLS_PRIORITY:-rdmacm,tcp,sockcm}
      UCX_TCP_CM_REUSEADDR: y
      UCX_PROTO_INFO: y
      # don't know, leave it for now
      UCX_TCP_KEEPINTVL: 1ms
      UCX_KEEPALIVE_INTERVAL: 1ms
      KVIKIO_NTHREADS: {{ kvikio_threads }}
      KVIKIO_TASK_SIZE: ${KVIKIO_TASK_SIZE:-4194304}
      KVIKIO_BOUNCE_BUFFER_SIZE: ${KVIKIO_BOUNCE_BUFFER_SIZE:-16777216}
      KVIKIO_REMOTE_IO_BACKEND: ${KVIKIO_REMOTE_IO_BACKEND:-EASY_THREADPOOL}
      KVIKIO_REMOTE_IO_NUM_REACTORS: ${KVIKIO_REMOTE_IO_NUM_REACTORS:-16}
      KVIKIO_REMOTE_IO_MAX_CONCURRENT_REQUESTS: ${KVIKIO_REMOTE_IO_MAX_CONCURRENT_REQUESTS:-256}
      KVIKIO_REMOTE_IO_NT_COPY: ${KVIKIO_REMOTE_IO_NT_COPY:-0}
      KVIKIO_REMOTE_IO_BUFFER_SIZE: ${KVIKIO_REMOTE_IO_BUFFER_SIZE:-0}
      KVIKIO_REMOTE_IO_INTERFACE: ${KVIKIO_REMOTE_IO_INTERFACE_GPU_{{ gpu_id }}:?KVIKIO_REMOTE_IO_INTERFACE_GPU_{{ gpu_id }} must be set}
      KVIKIO_REMOTE_IO_DNS_SHUFFLE: ${KVIKIO_REMOTE_IO_DNS_SHUFFLE:-0}
      KVIKIO_REMOTE_IO_KTLS: ${KVIKIO_REMOTE_IO_KTLS:-0}
      KVIKIO_REMOTE_IO_DISCARD: ${KVIKIO_REMOTE_IO_DISCARD:-0}
      KVIKIO_LOG_LEVEL: ${KVIKIO_LOG_LEVEL:-OFF}
      LIBCUDF_NUM_HOST_WORKERS: ${LIBCUDF_NUM_HOST_WORKERS:-32}
      CUDA_MODULE_LOADING: ${CUDA_MODULE_LOADING:-LAZY}
      CUDA_VISIBLE_DEVICES: {{ gpu_id }}
    volumes:
      - ${UCX_RUNTIME_ROOT:-/home/ubuntu/Development/Velox/ucx-efa-test/ucx-1.21/install-efa}:/opt/ucx-runtime:ro
      - ../../config/generated/gpu/etc_common:/opt/presto-server/etc
      - ../../config/generated/gpu/etc_worker_{{ gpu_id }}/node.properties:/opt/presto-server/etc/node.properties
      - ../../config/generated/gpu/etc_worker_{{ gpu_id }}/config_native.properties:/opt/presto-server/etc/config.properties
      - ../../config/generated/gpu/etc_worker_{{ gpu_id }}/catalog/hive.properties:/opt/presto-server/etc/catalog/hive.properties
  {% endfor %}
  {% else %}
  # Combined GPU worker - runs {{ workers|length if workers else 1 }} presto servers in parallel, each pinned to a specific GPU
  presto-native-worker-gpu:
    <<: *gpu_worker_base
    container_name: presto-native-worker-gpu
{%- if workers %}
    # Profiling requires one container. Host networking still exposes every
    # ENA; launch_presto_servers.sh assigns one to each child process.
    network_mode: host
    command: ["bash", "/opt/presto_profiling_wrapper.sh"{% for gpu_id in workers %}, "{{ gpu_id }}"{% endfor %}]
    environment:
      NVIDIA_VISIBLE_DEVICES: all
      PROFILE: ${PROFILE:-}
      PROFILE_ARGS: ${PROFILE_ARGS:-}
      SERVER_START_TIMESTAMP: ${SERVER_START_TIMESTAMP:-}
      LD_LIBRARY_PATH: /opt/ucx-runtime/lib:/opt/ucx-runtime/lib/ucx:/usr/lib64/presto-native-libs
      UCX_MODULE_DIR: /opt/ucx-runtime/lib/ucx
      UCX_LOG_LEVEL: info #debug
      UCX_RNDV_PIPELINE_ERROR_HANDLING: ${UCX_RNDV_PIPELINE_ERROR_HANDLING:-y}
      UCX_RNDV_FRAG_SIZE: ${UCX_RNDV_FRAG_SIZE:-host:4M,cuda:4M}
      UCX_CUDA_COPY_ASYNC_MEM_TYPE: ${UCX_CUDA_COPY_ASYNC_MEM_TYPE:-cuda-managed}
      UCX_MAX_RNDV_RAILS: ${UCX_MAX_RNDV_RAILS:-1}
      UCX_TLS: ${UCX_TLS:-tcp,sm,cuda_copy,cuda_ipc}
      UCX_NET_DEVICES: ${UCX_NET_DEVICES:-}
      UCX_SOCKADDR_TLS_PRIORITY: ${UCX_SOCKADDR_TLS_PRIORITY:-rdmacm,tcp,sockcm}
      UCX_TCP_CM_REUSEADDR: y
      UCX_PROTO_INFO: y
      # don't know, leave it for now
      UCX_TCP_KEEPINTVL: 1ms
      UCX_KEEPALIVE_INTERVAL: 1ms
      KVIKIO_NTHREADS: {{ kvikio_threads }}
      KVIKIO_TASK_SIZE: ${KVIKIO_TASK_SIZE:-4194304}
      KVIKIO_BOUNCE_BUFFER_SIZE: ${KVIKIO_BOUNCE_BUFFER_SIZE:-16777216}
      KVIKIO_REMOTE_IO_BACKEND: ${KVIKIO_REMOTE_IO_BACKEND:-EASY_THREADPOOL}
      KVIKIO_REMOTE_IO_NUM_REACTORS: ${KVIKIO_REMOTE_IO_NUM_REACTORS:-16}
      KVIKIO_REMOTE_IO_MAX_CONCURRENT_REQUESTS: ${KVIKIO_REMOTE_IO_MAX_CONCURRENT_REQUESTS:-256}
      KVIKIO_REMOTE_IO_NT_COPY: ${KVIKIO_REMOTE_IO_NT_COPY:-0}
      KVIKIO_REMOTE_IO_BUFFER_SIZE: ${KVIKIO_REMOTE_IO_BUFFER_SIZE:-0}
      KVIKIO_REMOTE_IO_INTERFACE: ${KVIKIO_REMOTE_IO_INTERFACE:-}
{% for gpu_id in workers %}
      KVIKIO_REMOTE_IO_INTERFACE_GPU_{{ gpu_id }}: ${KVIKIO_REMOTE_IO_INTERFACE_GPU_{{ gpu_id }}:?KVIKIO_REMOTE_IO_INTERFACE_GPU_{{ gpu_id }} must be set}
      UCX_NET_DEVICES_GPU_{{ gpu_id }}: ${UCX_NET_DEVICES_GPU_{{ gpu_id }}:-}
{% endfor %}
      KVIKIO_REMOTE_IO_DNS_SHUFFLE: ${KVIKIO_REMOTE_IO_DNS_SHUFFLE:-0}
      KVIKIO_REMOTE_IO_KTLS: ${KVIKIO_REMOTE_IO_KTLS:-0}
      KVIKIO_REMOTE_IO_DISCARD: ${KVIKIO_REMOTE_IO_DISCARD:-0}
      KVIKIO_LOG_LEVEL: ${KVIKIO_LOG_LEVEL:-OFF}
      LIBCUDF_NUM_HOST_WORKERS: ${LIBCUDF_NUM_HOST_WORKERS:-32}
      CUDA_MODULE_LOADING: ${CUDA_MODULE_LOADING:-LAZY}
      CUDA_VISIBLE_DEVICES: "{% for id in workers %}{{ id }}{% if not loop.last %},{% endif %}{% endfor %}"
{% else %}
    environment:
      NVIDIA_VISIBLE_DEVICES: all
      PROFILE: ${PROFILE:-}
      PROFILE_ARGS: ${PROFILE_ARGS:-}
      SERVER_START_TIMESTAMP: ${SERVER_START_TIMESTAMP:-}
      LD_LIBRARY_PATH: /opt/ucx-runtime/lib:/opt/ucx-runtime/lib/ucx:/usr/lib64/presto-native-libs
      UCX_MODULE_DIR: /opt/ucx-runtime/lib/ucx
      UCX_LOG_LEVEL: info #debug
      UCX_RNDV_PIPELINE_ERROR_HANDLING: ${UCX_RNDV_PIPELINE_ERROR_HANDLING:-y}
      UCX_RNDV_FRAG_SIZE: ${UCX_RNDV_FRAG_SIZE:-host:4M,cuda:4M}
      UCX_CUDA_COPY_ASYNC_MEM_TYPE: ${UCX_CUDA_COPY_ASYNC_MEM_TYPE:-cuda-managed}
      UCX_MAX_RNDV_RAILS: ${UCX_MAX_RNDV_RAILS:-1}
      UCX_TLS: ${UCX_TLS:-tcp,sm,cuda_copy,cuda_ipc}
      UCX_NET_DEVICES: ${UCX_NET_DEVICES:-}
      UCX_SOCKADDR_TLS_PRIORITY: ${UCX_SOCKADDR_TLS_PRIORITY:-rdmacm,tcp,sockcm}
      UCX_TCP_CM_REUSEADDR: y
      UCX_PROTO_INFO: y
      # don't know, leave it for now
      UCX_TCP_KEEPINTVL: 1ms
      UCX_KEEPALIVE_INTERVAL: 1ms
      KVIKIO_NTHREADS: {{ kvikio_threads }}
      KVIKIO_TASK_SIZE: ${KVIKIO_TASK_SIZE:-4194304}
      KVIKIO_BOUNCE_BUFFER_SIZE: ${KVIKIO_BOUNCE_BUFFER_SIZE:-16777216}
      KVIKIO_REMOTE_IO_BACKEND: ${KVIKIO_REMOTE_IO_BACKEND:-EASY_THREADPOOL}
      KVIKIO_REMOTE_IO_NUM_REACTORS: ${KVIKIO_REMOTE_IO_NUM_REACTORS:-16}
      KVIKIO_REMOTE_IO_MAX_CONCURRENT_REQUESTS: ${KVIKIO_REMOTE_IO_MAX_CONCURRENT_REQUESTS:-256}
      KVIKIO_REMOTE_IO_NT_COPY: ${KVIKIO_REMOTE_IO_NT_COPY:-0}
      KVIKIO_REMOTE_IO_BUFFER_SIZE: ${KVIKIO_REMOTE_IO_BUFFER_SIZE:-0}
      KVIKIO_REMOTE_IO_INTERFACE: ${KVIKIO_REMOTE_IO_INTERFACE:-}
      KVIKIO_REMOTE_IO_DNS_SHUFFLE: ${KVIKIO_REMOTE_IO_DNS_SHUFFLE:-0}
      KVIKIO_REMOTE_IO_KTLS: ${KVIKIO_REMOTE_IO_KTLS:-0}
      KVIKIO_REMOTE_IO_DISCARD: ${KVIKIO_REMOTE_IO_DISCARD:-0}
      KVIKIO_LOG_LEVEL: ${KVIKIO_LOG_LEVEL:-OFF}
      LIBCUDF_NUM_HOST_WORKERS: ${LIBCUDF_NUM_HOST_WORKERS:-32}
      CUDA_MODULE_LOADING: ${CUDA_MODULE_LOADING:-LAZY}
      CUDA_VISIBLE_DEVICES: 0
{%- endif %}
    volumes:
      - /opt/dlami/nvme/presto-gpu-nvme-cache:/mnt/nvme_cache
      - ${UCX_RUNTIME_ROOT:-/home/ubuntu/Development/Velox/ucx-efa-test/ucx-1.21/install-efa}:/opt/ucx-runtime:ro
{%- if workers %}
      # Mount all etc directories for workers {{ workers|join(', ') }}
{%- for gpu_id in workers %}
      - ../../config/generated/gpu/etc_common:/opt/presto-server/etc{{ gpu_id }}
{%- endfor %}
{%- for gpu_id in workers %}
      # worker {{ gpu_id }} configs
      - ../../config/generated/gpu/etc_worker_{{ gpu_id }}/node.properties:/opt/presto-server/etc{{ gpu_id }}/node.properties
      - ../../config/generated/gpu/etc_worker_{{ gpu_id }}/config_native.properties:/opt/presto-server/etc{{ gpu_id }}/config.properties
      - ../../config/generated/gpu/etc_worker_{{ gpu_id }}/catalog/hive.properties:/opt/presto-server/etc{{ gpu_id }}/catalog/hive.properties
{%- endfor %}
{%- endif %}
{%- endif %}
{% if sccache %}

secrets:
  github_token:
    file: "${SCCACHE_AUTH_DIR:-${HOME}/.sccache-auth}/github_token"
  aws_credentials:
    file: "${SCCACHE_AUTH_DIR:-${HOME}/.sccache-auth}/aws_credentials"
{% endif %}
